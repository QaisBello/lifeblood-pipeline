  "measures": [
    {
      "name": "Run Count",
      "table": "Runs",
      "folder": "Runs",
      "format": "#,0",
      "dax": "COUNTROWS ( Runs )",
      "description": "Pipeline runs recorded."
    },
    {
      "name": "Latest Status",
      "table": "Runs",
      "folder": "Runs",
      "format": "General",
      "dax": "VAR _last = CALCULATE ( MAX ( Runs[Run Number] ), REMOVEFILTERS ( Runs ) )\nRETURN UPPER ( CALCULATE ( MAX ( Runs[status] ), REMOVEFILTERS ( Runs ), Runs[Run Number] = _last ) )",
      "description": "Status of the latest run."
    },
    {
      "name": "Latest Rows In",
      "table": "Runs",
      "folder": "Runs",
      "format": "#,0",
      "dax": "VAR _last = CALCULATE ( MAX ( Runs[Run Number] ), REMOVEFILTERS ( Runs ) )\nRETURN CALCULATE ( SUM ( Runs[rows_in] ), REMOVEFILTERS ( Runs ), Runs[Run Number] = _last )",
      "description": "Rows read by the latest run."
    },
    {
      "name": "Latest Rows Out",
      "table": "Runs",
      "folder": "Runs",
      "format": "#,0",
      "dax": "VAR _last = CALCULATE ( MAX ( Runs[Run Number] ), REMOVEFILTERS ( Runs ) )\nRETURN CALCULATE ( SUM ( Runs[rows_out] ), REMOVEFILTERS ( Runs ), Runs[Run Number] = _last )",
      "description": "Rows published by the latest run."
    },
    {
      "name": "Rows Removed",
      "table": "Runs",
      "folder": "Runs",
      "format": "#,0",
      "dax": "[Latest Rows In] - [Latest Rows Out]",
      "description": "Duplicates and misfiled rows removed in cleaning."
    },
    {
      "name": "Rows In",
      "table": "Runs",
      "folder": "Runs",
      "format": "#,0",
      "dax": "SUM ( Runs[rows_in] )",
      "description": "Rows read."
    },
    {
      "name": "Rows Out",
      "table": "Runs",
      "folder": "Runs",
      "format": "#,0",
      "dax": "SUM ( Runs[rows_out] )",
      "description": "Rows published."
    },
    {
      "name": "Gates Passed",
      "table": "Checks",
      "folder": "Quality gates",
      "format": "#,0",
      "dax": "CALCULATE ( COUNTROWS ( Checks ), Checks[passed] == TRUE () )",
      "description": "Quality gates passed in the latest run."
    },
    {
      "name": "Gates",
      "table": "Checks",
      "folder": "Quality gates",
      "format": "#,0",
      "dax": "COUNTROWS ( Checks )",
      "description": "Quality gates run."
    },
    {
      "name": "Gates Summary",
      "table": "Checks",
      "folder": "Quality gates",
      "format": "General",
      "dax": "[Gates Passed] & \" of \" & [Gates] & \" passed\"",
      "description": "For the card."
    },
    {
      "name": "Errors Failed",
      "table": "Checks",
      "folder": "Quality gates",
      "format": "#,0",
      "dax": "CALCULATE ( COUNTROWS ( Checks ), Checks[passed] == FALSE (), Checks[level] = \"error\" ) + 0",
      "description": "Failed error-level gates (any failure would have stopped publishing)."
    },
    {
      "name": "Check-ins",
      "table": "Responses",
      "folder": "Published data",
      "format": "#,0",
      "dax": "COUNTROWS ( Responses )",
      "description": "Published check-ins."
    },
    {
      "name": "Donors",
      "table": "Responses",
      "folder": "Published data",
      "format": "#,0",
      "dax": "DISTINCTCOUNT ( Responses[donor_id] )",
      "description": "Distinct anonymised donors."
    },
    {
      "name": "Donation Rate",
      "table": "Responses",
      "folder": "Published data",
      "format": "0.0%",
      "dax": "DIVIDE ( CALCULATE ( [Check-ins], Responses[donated] == TRUE () ), [Check-ins] )",
      "description": "Share of check-ins who donated."
    },
    {
      "name": "Deferrals",
      "table": "Responses",
      "folder": "Published data",
      "format": "#,0",
      "dax": "CALCULATE ( [Check-ins], Responses[donated] == FALSE () )",
      "description": "Check-ins turned away."
    },
    {
      "name": "Changes Logged",
      "table": "Change Log",
      "folder": "Change log",
      "format": "#,0",
      "dax": "COUNTROWS ( 'Change Log' )",
      "description": "Entries in the change log."
    },
    {
      "name": "Rows Out Stage",
      "table": "Stages",
      "folder": "Runs",
      "format": "#,0",
      "dax": "SUM ( Stages[rows_out] )",
      "description": "Rows leaving each stage."
    }
  ],
